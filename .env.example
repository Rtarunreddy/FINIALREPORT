# Copy to backend/.env values into your host's environment. Never commit real secrets.
REPORT_READY_SESSION_SECRET=change-me-to-a-random-string-of-48-or-more-characters
REPORT_READY_COOKIE_SECURE=true
DATABASE_URL=postgresql://user:password@host:5432/report_ready   # omit for a local SQLite file
REPORT_READY_STORAGE=s3                  # or "local" (files under REPORT_READY_DATA/files)
REPORT_READY_S3_BUCKET=report-ready-files
REPORT_READY_S3_ENDPOINT=                # S3-compatible stores such as Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REPORT_READY_RETENTION_HOURS=24          # free plan, 1-168
REPORT_READY_PAID_RETENTION_HOURS=2160   # paid plans (90 days)
REPORT_READY_PUBLIC_URL=https://your-app.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend account and verified sender are required to enable password recovery.
RESEND_API_KEY=
REPORT_READY_EMAIL_FROM=Report Ready <no-reply@your-verified-domain.example>
# Single-user desktop mode (set automatically by start.bat): no accounts, no sign-in.
# REPORT_READY_LOCAL_MODE=1

# Phase 3: leave disabled until the pilot and Stripe sandbox checks pass.
REPORT_READY_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
